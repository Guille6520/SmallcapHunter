# SmallCap Hunter — plantilla de variables de entorno
# Copia este archivo a .env y rellena tus valores.
# En Windows, si no usas .env, recuerda que las variables de entorno
# del terminal se pierden al cerrarlo — hay que redefinirlas cada sesión.

# PostgreSQL (Docker). 127.0.0.1 y NO "localhost": con Docker Desktop
# en Windows, localhost puede resolver mal.
DB_HOST=127.0.0.1
DB_PORT=5434
DB_NAME=smallcap_hunter
DB_USER=postgres
# Obligatoria con docker compose (la usa para crear la base y para que la API y el
# dashboard se conecten). Elige la tuya; no la compartas ni la subas a git.
DB_PASSWORD=

# Puertos del host que publica docker-compose.yml (opcionales; estos son los de
# por defecto). Útiles si ya tienes otro Postgres, API o Streamlit en esos puertos.
# DB_PORT (arriba) también es el puerto de la base en el host.
# API_PORT=8000
# DASHBOARD_PORT=8501

# LLMs de la Capa 3 — dos votos ciegos fijos, Claude (Haiku 4.5) y Gemini (2.5 Flash).
# Claude ocupó en sep-2026 el hueco de un modelo gratuito vía OpenRouter
# (Llama, GPT-OSS, Nemotron) que fallaba con JSON roto o el proveedor
# saturado una parte relevante de las veces (medido en las pasadas de sep-2026).
# Es de pago (céntimos por llamada), pero fiable.
# Gemini se usa también para los embeddings del RAG (Capa 4). Con la cuota
# gratuita (20 llamadas/día) caben unas 6-10 empresas nuevas al día.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# La SEC exige un email de contacto REAL en el User-Agent de cada
# petición. Con uno falso se arriesga un bloqueo 403.
SEC_CONTACT_EMAIL=

# Alertas por Telegram (opcional — sin esto todo funciona igual).
# El token lo da @BotFather al crear el bot. Para el chat id: escribe
# algo a tu bot y mira https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Vista personal de seguimiento de precios de las empresas analizadas
# (apagada por defecto: no es un resultado del proyecto ni consejo de
# inversión, y no debe verse en demos ni en despliegues públicos).
# Ponla a 1 solo en tu .env local.
MOSTRAR_SEGUIMIENTO=0

# Dónde guardar las copias de seguridad de la base (backup_db.py). Opcional: por
# defecto, la carpeta backups/ del proyecto. Apúntala a otro disco o a una carpeta
# sincronizada si quieres que sobrevivan a un fallo del disco.
# BACKUP_DIR=

# Nombre del contenedor de Postgres para la copia de seguridad (backup_db.py). Por defecto
# smallcap_hunter_db. Si usas `docker compose up`, ponlo al que muestre `docker compose ps`.
# DB_CONTAINER=smallcap_hunter_db

# Segundos de pausa entre llamadas de generar_embeddings_rag.py (opcional, 1.5 por
# defecto): evita el límite por minuto de la API de embeddings.
# PAUSA_EMBEDDINGS_SEGUNDOS=1.5
